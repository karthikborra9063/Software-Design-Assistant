# Copy this file to `.env` and fill in real values. `.env` is gitignored — NEVER commit it.
#
# UNIFIED setup: the SAME models run in local dev and in production — Jina embeddings + the
# Groq LLM cascade. Local and prod differ only in DATABASE_URL / APP_ENV / FRONTEND_ORIGIN.

# ---- Environment ----
APP_ENV=development
FRONTEND_ORIGIN=*

# ---- Flask / auth ----
SECRET_KEY=change-me
JWT_SECRET=change-me
JWT_EXPIRES_HOURS=12

# ---- Database (Neon; use the pooled endpoint) ----
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require

# ---- Uploads / limits ----
# MAX_UPLOAD_MB   = compressed ZIP size cap (Flask body limit)
# MAX_UNCOMPRESSED_MB = uncompressed-size cap (zip-bomb guard)
# MAX_ARCHIVE_ENTRIES = total files allowed in the ZIP (extraction-cost guard)
# MAX_REPO_FILES  = how many files are actually indexed (bounds chunks/storage)
# Defaults are prod-safe; raise them locally for large projects (e.g. 200 / 600 / 60000).
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=300
MAX_ARCHIVE_ENTRIES=20000
MAX_REPO_FILES=2000
# UPLOAD_TMP optional; defaults to a temp dir.

# ---- Embeddings: Jina (hosted, 1024-dim) — same in dev and prod ----
# Free key: https://jina.ai/embeddings
EMBED_BASE_URL=https://api.jina.ai/v1
EMBED_API_KEY=your-jina-key-here
EMBED_MODEL=jina-embeddings-v3
EMBED_DIM=1024
# Rate-limit pacing for Jina's free tier (100k tokens/min). Keep headroom under the cap.
EMBED_TPM=90000
EMBED_BATCH_TOKENS=8000

# ---- Retrieval ----
TOP_K=10
CONFIDENCE_THRESHOLD=0.45
# Reranking: LangChain's Jina cross-encoder (JinaRerank) reorders the vector candidate pool.
# Uses the Jina key above by default.
RERANK_ENABLED=1
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_POOL=30

# ---- Conversation memory ----
# Recent turns replayed to the model and used to reformulate a follow-up into a standalone query.
HISTORY_WINDOW=3

# ---- Background worker ----
WORKER_CONCURRENCY=1

# ---- LLM cascade: Groq (same key reused across all four; only model_id differs) ----
# Free key: https://console.groq.com
LLM_1_PROVIDER=groq
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_API_KEY=your-groq-key-here
LLM_1_MODEL=qwen/qwen3.6-27b
LLM_1_REASONING_EFFORT=none   # Qwen3 is a reasoning model — disable chain-of-thought so it answers directly

LLM_2_PROVIDER=groq
LLM_2_BASE_URL=https://api.groq.com/openai/v1
LLM_2_API_KEY=your-groq-key-here
LLM_2_MODEL=openai/gpt-oss-120b

LLM_3_PROVIDER=groq
LLM_3_BASE_URL=https://api.groq.com/openai/v1
LLM_3_API_KEY=your-groq-key-here
LLM_3_MODEL=llama-3.3-70b-versatile

LLM_4_PROVIDER=groq
LLM_4_BASE_URL=https://api.groq.com/openai/v1
LLM_4_API_KEY=your-groq-key-here
LLM_4_MODEL=llama-3.1-8b-instant
